# Copy to .env and replace every value. .env is gitignored.
POSTGRES_HOST_PORT=5433
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
AGENT_DB_OWNER_PASSWORD=change-me
AGENT_DB_RUNTIME_PASSWORD=change-me
REFUND_DB_OWNER_PASSWORD=change-me
REFUND_DB_RUNTIME_PASSWORD=change-me

# Used by services, migrations and tests (host side).
AGENT_DB_OWNER_URL=postgresql+psycopg://agent_owner:change-me@localhost:5433/agent
AGENT_DB_RUNTIME_URL=postgresql+psycopg://agent_runtime:change-me@localhost:5433/agent
REFUND_DB_OWNER_URL=postgresql+psycopg://refund_api_owner:change-me@localhost:5433/refund_api
REFUND_DB_RUNTIME_URL=postgresql+psycopg://refund_api_runtime:change-me@localhost:5433/refund_api

# refund-api service (ADR-004, ADR-010). Durations are seconds.
APP_ENV=development
# Service tokens (ADR-010 Part 6): at least 32 characters each. Generate with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotation order: docs/ops/refund-api-token-rotation.md
REFUND_API_TOKEN_CURRENT=
REFUND_API_TOKEN_NEXT=
# The agent's copy: must equal one of the two above.
REFUND_API_TOKEN=
REFUND_API_PROCESSING_BUDGET_SECONDS=5
REFUND_API_POOL_TIMEOUT_SECONDS=2
# Must exceed MAX_RETRY_WINDOW + MAX_RECOVERY_DELAY (ADR-004), or the service won't start.
REFUND_API_KEY_RETENTION_SECONDS=86400
REFUND_API_MAX_RETRY_WINDOW_SECONDS=600
REFUND_API_MAX_RECOVERY_DELAY_SECONDS=3600
