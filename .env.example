# Copy to .env and replace every value. .env is gitignored.
POSTGRES_HOST_PORT=5433
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
AGENT_DB_OWNER_PASSWORD=change-me
AGENT_DB_RUNTIME_PASSWORD=change-me
REFUND_DB_OWNER_PASSWORD=change-me
REFUND_DB_RUNTIME_PASSWORD=change-me

# Used by services, migrations and tests (host side).
AGENT_DB_OWNER_URL=postgresql+psycopg://agent_owner:change-me@localhost:5433/agent
AGENT_DB_RUNTIME_URL=postgresql+psycopg://agent_runtime:change-me@localhost:5433/agent
REFUND_DB_OWNER_URL=postgresql+psycopg://refund_api_owner:change-me@localhost:5433/refund_api
REFUND_DB_RUNTIME_URL=postgresql+psycopg://refund_api_runtime:change-me@localhost:5433/refund_api

# refund-api service (ADR-004, ADR-010). Durations are seconds.
APP_ENV=development
# Service tokens (ADR-010 Part 6): at least 32 characters each. Generate with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotation order: docs/ops/refund-api-token-rotation.md
REFUND_API_TOKEN_CURRENT=
REFUND_API_TOKEN_NEXT=
# The agent's copy: must equal one of the two above.
REFUND_API_TOKEN=
REFUND_API_PROCESSING_BUDGET_SECONDS=5
REFUND_API_POOL_TIMEOUT_SECONDS=2
# Must exceed MAX_RETRY_WINDOW + MAX_RECOVERY_DELAY (ADR-004), or the service won't start.
# Also the key-retention floor, set on every deployment by `python -m refund_api.retention_floor`.
REFUND_API_KEY_RETENTION_SECONDS=86400
REFUND_API_MAX_RETRY_WINDOW_SECONDS=600
REFUND_API_MAX_RECOVERY_DELAY_SECONDS=3600

# The agent's refund client (ADR-012, ADR-013). refund-api is the single source of the
# retry window: the worker reads it from GET /config before every send. The agent only
# caps what it will accept; its worst case (attempts x timeout + (attempts-1) x backoff
# cap, 72 s with these values) must fit under that cap or the agent won't start.
REFUND_API_URL=http://localhost:8000
REFUND_CLIENT_TIMEOUT_SECONDS=8
REFUND_CLIENT_MAX_ATTEMPTS=5
REFUND_CLIENT_BACKOFF_BASE_SECONDS=0.5
REFUND_CLIENT_BACKOFF_CAP_SECONDS=8
REFUND_CLIENT_MAX_PROVIDER_WINDOW_SECONDS=900
# The smallest processing budget the agent accepts from refund-api (ADR-016): it sizes the
# reconciler's quiet period, so an under-reported budget is treated as a broken read. Keep it
# at or below REFUND_API_PROCESSING_BUDGET_SECONDS.
REFUND_CLIENT_MIN_PROVIDER_BUDGET_SECONDS=1

# The worker's claim (ADR-004 step 7, ADR-014). The lease must be at least 3 heartbeats. A
# step may take at most client timeout + backoff cap + lock timeout + margin (16.5 s here)
# before the heartbeat stops renewing; the statement timeout must sit below that.
WORKER_LEASE_SECONDS=15
WORKER_HEARTBEAT_SECONDS=5
WORKER_LIVENESS_MARGIN_SECONDS=0.5
WORKER_CLAIM_COOLDOWN_SECONDS=30
WORKER_STATEMENT_TIMEOUT_SECONDS=5
WORKER_LOCK_TIMEOUT_SECONDS=1
# The provider-config cache gates claiming (ADR-012 Part 4); stale after 2+ missed refreshes.
WORKER_CONFIG_REFRESH_SECONDS=30
WORKER_CONFIG_STALE_SECONDS=90
# Pre-send: failed checks before escalating (ADR-009), lock timeouts in a row before a
# cooldown release (ADR-005), and cooldown releases in a row before escalating or paging (S12).
WORKER_PRESEND_MAX_ATTEMPTS=3
WORKER_LOCK_RETRY_MAX=3
WORKER_RELEASE_STREAK_LIMIT=5
# ADR-014 Part 4: failed per-send config reads in a row before an EXECUTING run is released.
WORKER_MAX_FAILED_READS=5
# How often an idle worker polls for work, and how long a stopping worker lets an attempt
# already on the wire finish (must exceed the client timeout).
WORKER_POLL_SECONDS=2
WORKER_SHUTDOWN_GRACE_SECONDS=15
# ADR-016: the reconciler's quiet period is the larger of each run's recorded bound and the
# client timeout plus refund-api's current budget, plus this margin (refund-api's gap between
# its deadline check and its commit, and transit time).
RECONCILER_QUIET_MARGIN_SECONDS=2
# ADR-004/016/017: a NEEDS_RECONCILIATION run unresolved this long alerts, once per run per
# ALERT_RATE_LIMIT_SECONDS.
RECONCILER_STALE_ALERT_SECONDS=3600
# ADR-017 S3: ... and unresolved this long it pages, once per run per ALERT_RATE_LIMIT_SECONDS
# (must exceed the alert threshold). For a run whose lookups fail alone this is the paging
# delay. Runs whose latest "not found" the kill switch held page once together instead (S4).
RECONCILER_STALE_PAGE_SECONDS=14400
# ADR-018: provider breakers, one per path (sends gate the send loop, lookups the reconcile loop),
# judged on real requests because GET /config never touches refund-api's database. Open after
# this many refund-api-type failures in a row (must be below REFUND_CLIENT_MAX_ATTEMPTS), stay
# open for OPEN_SECONDS, doubling between failed probes up to MAX_OPEN_SECONDS (keep it below
# refund-api's retry window minus the client timeout: a probe-started run then gets another probe
# inside its window), and page once an outage lasts PAGE_AFTER_SECONDS (must be below
# RECONCILER_STALE_PAGE_SECONDS). Not ADR-009's policy breaker.
PROVIDER_BREAKER_FAILURE_THRESHOLD=3
PROVIDER_BREAKER_OPEN_SECONDS=30
PROVIDER_BREAKER_MAX_OPEN_SECONDS=300
PROVIDER_BREAKER_PAGE_AFTER_SECONDS=600
# ADR-019 S6, ADR-021: both seeds write fake data (the agent's customers and orders, refund-api's
# charges), so they run only when this is exactly "true". Leave it unset on any real deployment.
DEMO_SEED_ENABLED=true
# The worker's database pool (at least 2: the heartbeat has its own connection). The prepare
# threshold is psycopg's: empty = driver default, "off" = no prepared statements (needed
# behind PgBouncer in transaction mode; ADR-005, decided in the deployment ADR).
WORKER_DB_POOL_SIZE=4
AGENT_DB_PREPARE_THRESHOLD=

# Refund policy thresholds (ADR-009), validated at startup. Amounts in minor units,
# durations in seconds (30 days = 2592000, 7 days = 604800).
POLICY_CURRENCY=USD
POLICY_AUTO_APPROVE_MAX_MINOR=5000
POLICY_AUTO_APPROVE_BUDGET_MINOR=10000
POLICY_PER_CUSTOMER_LIMIT_MINOR=20000
POLICY_PER_CUSTOMER_WINDOW_SECONDS=2592000
POLICY_REFUND_WINDOW_SECONDS=2592000
POLICY_BREAKER_THRESHOLD_MINOR=100000
POLICY_PENDING_REVIEW_CAP=3
POLICY_DAILY_PROPOSAL_CAP=5
POLICY_GLOBAL_REVIEW_QUEUE_CAP=50
POLICY_DECLINE_COOLDOWN_SECONDS=604800

# Crash tests only (ADR-004): honored by python -m agent_testing.worker, refused by the
# production worker. Leave empty.
CRASH_POINT=
DEBUG_FAULT_INJECTION=
# At most one alert line per kind (and run) per interval; repeats are counted (ADR-014 Part 6).
ALERT_RATE_LIMIT_SECONDS=300
