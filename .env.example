# Copy to .env and replace every value. .env is gitignored.
POSTGRES_HOST_PORT=5433
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
AGENT_DB_OWNER_PASSWORD=change-me
AGENT_DB_RUNTIME_PASSWORD=change-me
REFUND_DB_OWNER_PASSWORD=change-me
REFUND_DB_RUNTIME_PASSWORD=change-me

# Used by services, migrations and tests (host side).
AGENT_DB_OWNER_URL=postgresql+psycopg://agent_owner:change-me@localhost:5433/agent
AGENT_DB_RUNTIME_URL=postgresql+psycopg://agent_runtime:change-me@localhost:5433/agent
REFUND_DB_OWNER_URL=postgresql+psycopg://refund_api_owner:change-me@localhost:5433/refund_api
REFUND_DB_RUNTIME_URL=postgresql+psycopg://refund_api_runtime:change-me@localhost:5433/refund_api
